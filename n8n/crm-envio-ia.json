{
  "name": "CRM Envio IA",
  "active": false,
  "nodes": [
    {
      "id": "webhook-ia",
      "name": "Webhook IA",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "parameters": {
        "httpMethod": "POST",
        "path": "crm-envio-ia",
        "responseMode": "lastNode",
        "options": {}
      }
    },
    {
      "id": "split-ia",
      "name": "Split messages",
      "type": "n8n-nodes-base.splitOut",
      "typeVersion": 1,
      "position": [220, 0],
      "parameters": {
        "fieldToSplitOut": "body.messages",
        "options": { "destinationFieldName": "msg" }
      }
    },
    {
      "id": "evo-send-ia",
      "name": "Evolution send",
      "type": "n8n-nodes-evolution-api.evolutionApi",
      "typeVersion": 1,
      "position": [440, 0],
      "parameters": {
        "resource": "messages-api",
        "instanceName": "={{ $('Webhook IA').first().json.body.instance }}",
        "remoteJid": "={{ $('Webhook IA').first().json.body.phone }}",
        "messageText": "={{ $json.msg }}",
        "options_message": { "delay": 0, "linkPreview": false }
      },
      "credentials": {
        "evolutionApi": { "id": "NhrloDUqGVTkh9Xq", "name": "Evo Global" }
      }
    },
    {
      "id": "save-ia",
      "name": "Salva IA (chat_messages)",
      "type": "n8n-nodes-base.supabase",
      "typeVersion": 1,
      "position": [660, 0],
      "executeOnce": true,
      "parameters": {
        "tableId": "chat_messages",
        "fieldsUi": {
          "fieldValues": [
            { "fieldId": "phone", "fieldValue": "={{ $('Webhook IA').first().json.body.phone }}" },
            { "fieldId": "bot_message", "fieldValue": "={{ $('Webhook IA').first().json.body.messages.join(' | ') }}" },
            { "fieldId": "message_type", "fieldValue": "text" },
            { "fieldId": "created_at", "fieldValue": "={{ $now }}" },
            { "fieldId": "client_id", "fieldValue": "={{ $('Webhook IA').first().json.body.client_id }}" }
          ]
        }
      },
      "credentials": {
        "supabaseApi": { "id": "KfaFJK3xoVfTJGUL", "name": "Supabase account" }
      }
    }
  ],
  "connections": {
    "Webhook IA": { "main": [[{ "node": "Split messages", "type": "main", "index": 0 }]] },
    "Split messages": { "main": [[{ "node": "Evolution send", "type": "main", "index": 0 }]] },
    "Evolution send": { "main": [[{ "node": "Salva IA (chat_messages)", "type": "main", "index": 0 }]] }
  },
  "settings": {
    "executionOrder": "v1",
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "saveManualExecutions": true,
    "saveExecutionProgress": true
  },
  "meta": null
}
