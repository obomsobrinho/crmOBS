  {
   "id": "text-1bs",
   "type": "text",
   "x": 30,
   "y": 2930,
   "width": 1019.2,
   "height": 100,
   "angle": 0,
   "strokeColor": "#0b7285",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
