   "roundness": null,
   "seed": 1721,
   "version": 1,
   "versionNonce": 1722,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "OBJETIVO: não mandar áudio para um modelo de IA na nuvem quando a transcrição local bastar.\nHOJE o áudio já vira texto antes do agente, mas quem transcreve é o whisper-1 da OpenAI\n(nó \"Whisper\" do n8n): custo por minuto, latência de rede e dependência externa.\nO STT local entraria NO LUGAR desse nó; o resto do fluxo não muda.",
   "fontSize": 20,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "OBJETIVO: não mandar áudio para um modelo de IA na nuvem quando a transcrição local bastar.\nHOJE o áudio já vira texto antes do agente, mas quem transcreve é o whisper-1 da OpenAI\n(nó \"Whisper\" do n8n): custo por minuto, latência de rede e dependência externa.\nO STT local entraria NO LUGAR desse nó; o resto do fluxo não muda.",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
