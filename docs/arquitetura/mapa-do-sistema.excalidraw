  {
   "id": "text-1by",
   "type": "text",
   "x": 40,
   "y": 3088,
   "width": 211.12000000000003,
   "height": 162.5,
   "angle": 0,
   "strokeColor": "#1e1e1e",
   "backgroundColor": "transparent",
   "fillStyle": "solid",
   "strokeWidth": 1,
   "strokeStyle": "solid",
   "roughness": 1,
   "opacity": 100,
   "groupIds": [],
   "frameId": null,
   "roundness": null,
   "seed": 1727,
   "version": 1,
   "versionNonce": 1728,
   "isDeleted": false,
   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "MEDIR: STT local (futuro)\nCusto/mês: A medir\nCPU: A medir\nRAM: A medir\nTokens: A medir\nLatência: A medir\nNº de requisições: A medir\nDependência externa: A medir\nPode ser otimizado? SIM / NÃO\nOnde roda? A definir",
   "fontSize": 13,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "middle",
   "containerId": "rectangle-1bv",
   "originalText": "MEDIR: STT local (futuro)\nCusto/mês: A medir\nCPU: A medir\nRAM: A medir\nTokens: A medir\nLatência: A medir\nNº de requisições: A medir\nDependência externa: A medir\nPode ser otimizado? SIM / NÃO\nOnde roda? A definir",
   "autoResize": true,
   "lineHeight": 1.25
  },
  {
   "id": "text-1c1",
