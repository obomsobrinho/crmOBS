   "updated": 1,
   "link": null,
   "locked": false,
   "text": "Troca SÓ o áudio do passo 4. O resto não muda.\n\nHoje:   áudio -> whisper-1 (OpenAI, nuvem) -> texto\nFuturo: áudio -> Whisper / Parakeet LOCAL -> texto\n\nObjetivo: não mandar áudio para uma IA na nuvem\nquando a transcrição local bastar.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "Troca SÓ o áudio do passo 4. O resto não muda.\n\nHoje:   áudio -> whisper-1 (OpenAI, nuvem) -> texto\nFuturo: áudio -> Whisper / Parakeet LOCAL -> texto\n\nObjetivo: não mandar áudio para uma IA na nuvem\nquando a transcrição local bastar.",
   "autoResize": true,
   "lineHeight": 1.25
  },
