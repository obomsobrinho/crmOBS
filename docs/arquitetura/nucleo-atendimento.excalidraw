   "boundElements": [],
   "updated": 1,
   "link": null,
   "locked": false,
   "text": "TEMPO TOTAL (1 a 12): A medir\n    separado em: espera de propósito (15s) + trabalho\n\nCUSTO POR MENSAGEM RESPONDIDA: A medir\n    variável: OpenAI (painel de uso ou agent_turns)\n    fixo: soma das faturas do mês / mensagens do mês\n\nPrimeiro achar o bloco que mais pesa em tempo\nou em custo. Só depois abrir esse bloco por dentro.",
   "fontSize": 19,
   "fontFamily": 5,
   "textAlign": "left",
   "verticalAlign": "top",
   "containerId": null,
   "originalText": "TEMPO TOTAL (1 a 12): A medir\n    separado em: espera de propósito (15s) + trabalho\n\nCUSTO POR MENSAGEM RESPONDIDA: A medir\n    variável: OpenAI (painel de uso ou agent_turns)\n    fixo: soma das faturas do mês / mensagens do mês\n\nPrimeiro achar o bloco que mais pesa em tempo\nou em custo. Só depois abrir esse bloco por dentro.",
   "autoResize": true,
   "lineHeight": 1.25
  },
